<Window x:Class="Orion.Views.LevelSectioner"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:Orion"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Height="auto"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Title="Section Box"
        >

    <Border Padding="10">
        <StackPanel>
            <Label Content="Level 3D View Generator" FontWeight="Bold" />
            <Grid>
                <!-- Grid Definitions -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Row 1 -->
                <Label Content="From:" Grid.Column="0" Grid.Row="0" Margin="0,0,0,26" Grid.RowSpan="2"/>
                <ComboBox x:Name="FromLevels" Height="25" Grid.Column="1" Grid.Row="0" Grid.ColumnSpan="2" Margin="0,3,0,3" DisplayMemberPath="Name" SelectedValuePath="Id"/>

                <!-- Row 2 -->
                <Label Content="To:" Grid.Column="0" Grid.Row="1"/>
                <ComboBox x:Name="ToLevels" Height="25" Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,3,0,3"  DisplayMemberPath="Name" SelectedValuePath="Id"/>


            </Grid>

            <TabControl>
                <TabItem Header="Crop by Manual">
                    <Grid>
                        <!-- Grid Definitions -->
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>


                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Column="0" Margin="0,0,5,0">
                            <!-- Grid Definitions -->
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Label Content="X+" Grid.Column="0" Grid.Row="0"/>
                            <TextBox x:Name="XPos" Text="10" Height="20" Width="60" Grid.Column="1" Grid.Row="0" PreviewTextInput="NumberValidationTextBox" DataObject.Pasting="TextBox_Pasting"/>

                            <Label Content="X-" Grid.Column="2" Grid.Row="0"/>
                            <TextBox x:Name="XNeg" Text="10" Height="20" Width="60" Grid.Column="3" Grid.Row="0" PreviewTextInput="NumberValidationTextBox" DataObject.Pasting="TextBox_Pasting"/>

                            <Label Content="Y+" Grid.Column="0" Grid.Row="1"/>
                            <TextBox x:Name="YPos" Text="10" Height="20" Width="60" Grid.Column="1" Grid.Row="1" PreviewTextInput="NumberValidationTextBox" DataObject.Pasting="TextBox_Pasting"/>

                            <Label Content="Y-" Grid.Column="2" Grid.Row="1"/>
                            <TextBox x:Name="YNeg" Text="10" Height="20" Width="60" Grid.Column="3" Grid.Row="1" PreviewTextInput="NumberValidationTextBox" DataObject.Pasting="TextBox_Pasting"/>
                        </Grid>

                        <Grid Grid.Column="1">
                            <!-- Grid Definitions -->
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Test Bounding Box&#x0a;in Current 3D View:"
                                TextWrapping="Wrap"
                                Grid.Row="0"
                                Margin="0,0,0,0"/>

                            <Button x:Name="TestButton"
                                Grid.Row="1"
                                Height="25"
                                Content="Test"
                                Cursor="Hand"
                                Background="#383838"
                                Foreground="White" 
                                Padding="0"
                                FontSize="10" Click="TestBox"/>
                            </Grid>



                        <Button x:Name="GenerateButtonManual"
                            Grid.Column="0"
                            Grid.Row="1"
                            Margin="0,5,10,0"
                            Height="30"
                            Width="100"
                            Content="Generate"
                            Cursor="Hand"
                            Background="#383838"
                            Foreground="White" 
                            Padding="0"
                            FontSize="10"
                            HorizontalAlignment="Left"
                            Click="GenerateManual"/>
                    </Grid>

                </TabItem>

                <TabItem Header="Crop by View">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>

                        </Grid.RowDefinitions>
                        
                        <TextBlock Text="Copy Current View XY for cropping"
                                TextWrapping="Wrap"
                                Grid.Row="0"
                                   Padding="0,5"
                                Margin="0,0,0,0"/>

                        <StackPanel Grid.Row="1">
                            <Label x:Name="CopiedMinLabel" Content="Min: (0,0)"/>
                            <Label x:Name="CopiedMaxLabel" Content="Max: (0,0)"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Orientation="Horizontal">
 

                            <Button x:Name="GenerateButtonCopy"
                                Grid.Column="0"
                                Grid.Row="1"
                                Margin="0,5,10,0"
                                Height="30"
                                Width="100"
                                Content="Generate"
                                Cursor="Hand"
                                Background="#383838"
                                Foreground="White" 
                                Padding="0"
                                FontSize="10"
                                HorizontalAlignment="Left"
                                Click="GenerateCopy"/>

                            <Button x:Name="CopyButton"
                                    Grid.Column="1"
                                    Margin="0,5,10,0"
                                    Height="30"
                                    Width="100"
                                    Content="Copy"
                                    Cursor="Hand"
                                    Background="#383838"
                                    Foreground="White" 
                                    Padding="0"
                                    FontSize="10"
                                    HorizontalAlignment="Left"
                                    Click="CopyBox"/>
                        </StackPanel>
                    </Grid>

                </TabItem>
                
                
            </TabControl>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>




                <Button x:Name="CloseButton"
                        Grid.Column="1"
                        Width="50"
                        Height="20"
                        VerticalAlignment="Bottom"
                        HorizontalAlignment="Right"
                        Margin="10,5,0,0"
                        Content="Close"
                        Cursor="Hand"
                        Background="#383838"
                        Foreground="White" 
                        Padding="0"
                        FontSize="10" Click="CloseMenu"/>

            </Grid>

        </StackPanel>


    </Border>
</Window>
