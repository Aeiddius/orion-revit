<Window x:Class="Orion.Views.SectionMenu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:Orion"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Height="auto"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Title="Section Box"
        >

    <!-- Put the shared variable + style here -->
    <Window.Resources>
        <sys:Double x:Key="ButtonHeight">20</sys:Double>

        <Style TargetType="Button">
            <Setter Property="Margin" Value="3,3,0,0"/>
            <Setter Property="BorderThickness" Value="0.5"/>
            <Setter Property="Background" Value="WhiteSmoke"/>
        </Style>


        <!-- remove padding inside the ComboBox itself -->
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="3,0,0,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="BorderThickness" Value="0.5"/>
        </Style>

    </Window.Resources>

    <Border Padding="10">
        <StackPanel>
            <Grid Margin="0,0,0,7">
                <!-- grid defs... -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Button x:Name="SetButton" Height="{StaticResource ButtonHeight}" Grid.Column="0" Grid.Row="0" Content="Set" Cursor="Hand" Click="SetSectionBoxCommand" />
                <Button x:Name="ToggleButton" Height="{StaticResource ButtonHeight}" Grid.Column="0" Grid.Row="1" Content="Toggle" Cursor="Hand" Click="ToggleSectionBoxCommand" />
                <Button x:Name="GrowButton" Height="{StaticResource ButtonHeight}" Grid.Column="1" Grid.Row="0" Content="Grow" Cursor="Hand" Click="GrowSectionBoxCommand"/>
                <Button x:Name="GrowYButton" Height="{StaticResource ButtonHeight}" Grid.Column="2" Grid.Row="0" Content="Y+" Cursor="Hand" Click="GrowYSectionBoxCommand"/>
                <Button x:Name="GrowXButton" Height="{StaticResource ButtonHeight}" Grid.Column="3" Grid.Row="0" Content="X+" Cursor="Hand" Click="GrowXSectionBoxCommand"/>
                <Button x:Name="GrowZButton" Height="{StaticResource ButtonHeight}" Grid.Column="4" Grid.Row="0" Content="Z+" Cursor="Hand" Click="GrowZSectionBoxCommand"/>
                <Button x:Name="ShrinkButton" Height="{StaticResource ButtonHeight}" Grid.Column="1" Grid.Row="1" Content="Shrink" Cursor="Hand" VerticalAlignment="Top" Click="ShrinkSectionBoxCommand"/>
                <Button x:Name="ShrinkYButton" Height="{StaticResource ButtonHeight}" Grid.Column="2" Grid.Row="1" Content="Y-" Cursor="Hand" Click="ShrinkYSectionBoxCommand"/>
                <Button x:Name="ShrinkXButton" Height="{StaticResource ButtonHeight}" Grid.Column="3" Grid.Row="1" Content="X-" Cursor="Hand" Click="ShrinkXSectionBoxCommand"/>
                <Button x:Name="ShrinkZButton" Height="{StaticResource ButtonHeight}" Grid.Column="4" Grid.Row="1" Content="Z-" Cursor="Hand" Click="ShrinkZSectionBoxCommand"/>
                <Label Grid.Column="5" Grid.Row="0" Content="Step:"/>
                <TextBox x:Name="StepInput" Grid.Column="5" Grid.Row="1" Margin="3, 3, 0, 0" Text="1'-0&quot;" />
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <!-- Row 1 -->
                <Label Content="View:" Grid.Column="0" Grid.Row="0"/>
                <ComboBox x:Name="Combobox3DViews" Height="18" Grid.Column="1" Grid.Row="0" DisplayMemberPath="Name" SelectedValuePath="Id" />
                
                <!-- Row 2 -->
                <Label Content="Size:" Grid.Column="0" Grid.Row="1"/>
                <StackPanel Orientation="Horizontal" Grid.Column="1" Grid.Row="1" >
                    <ComboBox x:Name="ComboboxSizeMethod" Height="18" Width="130" SelectedIndex="1">
                        <ComboBoxItem Content="Specific Size"  Tag="specific"/>
                        <ComboBoxItem Content="Elements + Offset" Tag="elements"/>
                    </ComboBox>

                    <TextBox x:Name="SetSizeBox" Height="18" Margin="4,0,0,0"  Width="56"/>
                </StackPanel>



                <!-- Row 3 -->
                <StackPanel Orientation="Horizontal" Grid.Column="0" Grid.Row="2" Grid.ColumnSpan="2">
                    <Label Content="Template:" Grid.Column="0" Grid.Row="2"/>
                    <ComboBox x:Name="ComboboxTemplate" Height="18" Width="170" Grid.Column="1" Grid.Row="0"  DisplayMemberPath="Name" SelectedValuePath="Id">
                    </ComboBox>
                </StackPanel>

                <!-- Row 4 -->
                <StackPanel Orientation="Horizontal" Grid.Column="0" Grid.Row="3" Grid.ColumnSpan="2">
                    <Label Content="Open Windows Side by Side: "/>
                    <CheckBox x:Name="OpenSidebySideCheck" Margin="-5,3,0,0">
                        <CheckBox.LayoutTransform>
                            <ScaleTransform ScaleX="1.5" ScaleY="1.5"/>
                        </CheckBox.LayoutTransform>
                    </CheckBox>
                    <Button x:Name="ButtonClose" Width="45" Content="Close" HorizontalAlignment="Right" Background="#383838" Foreground="white"/>

                </StackPanel>

                <!-- Row 5 -->

            </Grid>

        </StackPanel>
    </Border>
</Window>
